name: <%= it.name %>

services:
   login:
      build:
         context: .
         target: login

      image: <%= it.name %>-login
      container_name: <%= it.name %>-login
      hostname: login

<% if (it.database) { %>
      depends_on:
         database:
            condition: service_healthy
<% } %>

      healthcheck:
         test: ["CMD", "scontrol", "ping"]
         interval: 5s
         timeout: 5s
         retries: 20
         start_period: 10s

      ports:
         - "<%= it.port %>:22"

      environment:
         MODULE_FRAMEWORK: <%= it.module %>

      volumes:
         - home:/home/dev
         - ./shared_cluster_key:/home/dev/.ssh/id_ed25519:ro
         - ./authorized_keys:/home/dev/.ssh/authorized_keys:ro
         - ./known_hosts:/home/dev/.ssh/known_hosts
         - ./hostkeys/login_ssh_host_ed25519_key:/etc/ssh/ssh_host_ed25519_key:ro
         - ./hostkeys/login_ssh_host_ed25519_key.pub:/etc/ssh/ssh_host_ed25519_key.pub:ro
         - ./munge.key:/tmp/munge.key:ro
         - ./conf/slurm.conf:/tmp/conf/slurm.conf:ro

<% if (it.database) { %>
         - ./conf/slurmdbd.conf:/tmp/conf/slurmdbd.conf:ro
<% } %>

<% if (it.module === "em") { %>
         - ./setup_scripts/environment_modules.sh:/tmp/setup_scripts/environment-modules.sh:ro
<% } %>

<% if (it.module === "lmod") { %>
         - ./setup_scripts/lmod.sh:/tmp/setup_scripts/lmod.sh:ro
<% } %>

      networks:
         - cluster


<% for (let i = 1; i <= it.nodes; i++) { %>
   node<%= String(i).padStart(2, "0") %>:
      build:
         context: .
         target: compute

      image: <%= it.name %>-compute
      container_name: <%= it.name %>-node<%= String(i).padStart(2, "0") %>

      hostname: node<%= String(i).padStart(2, "0") %>

      depends_on:
         login:
            condition: service_healthy

      mem_limit: <%= it.memory %>m
      cpus: <%= it.cpus %>

      environment:
         MODULE_FRAMEWORK: <%= it.module %>

      volumes:
         - home:/home/dev
         - ./shared_cluster_key:/home/dev/.ssh/id_ed25519:ro
         - ./authorized_keys:/home/dev/.ssh/authorized_keys:ro
         - ./known_hosts:/home/dev/.ssh/known_hosts
         - ./hostkeys/node<%= String(i).padStart(2, "0") %>_ssh_host_ed25519_key:/etc/ssh/ssh_host_ed25519_key:ro
         - ./hostkeys/node<%= String(i).padStart(2, "0") %>_ssh_host_ed25519_key.pub:/etc/ssh/ssh_host_ed25519_key.pub:ro
         - ./munge.key:/tmp/munge.key:ro
         - ./conf/slurm.conf:/tmp/conf/slurm.conf:ro

<% if (it.module === "em") { %>
         - ./setup_scripts/environment_modules.sh:/tmp/setup_scripts/environment_modules.sh:ro
<% } %>

<% if (it.module === "lmod") { %>
         - ./setup_scripts/lmod.sh:/tmp/setup_scripts/lmod.sh:ro
<% } %>

      networks:
         - cluster
<% } %>


<% if (it.database) { %>
   database:
      build:
         context: .
         target: database

      image: <%= it.name %>-database
      container_name: <%= it.name %>-database
      hostname: database

      healthcheck:
         test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "--silent"]
         interval: 5s
         timeout: 5s
         retries: 20
         start_period: 10s

      volumes:
         - ./conf:/tmp/conf:ro
         - ./munge.key:/tmp/munge.key:ro
         - ./setup_scripts/database.sh:/tmp/setup_scripts/database.sh:ro
         - ./hostkeys/database_ssh_host_ed25519_key:/etc/ssh/ssh_host_ed25519_key:ro
         - ./hostkeys/database_ssh_host_ed25519_key.pub:/etc/ssh/ssh_host_ed25519_key.pub:ro

      networks:
         - cluster
<% } %>


volumes:
   home:


networks:
   cluster:
      driver: bridge
