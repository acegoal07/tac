{
   "name": "@acegoal07/tac",
   "description": "A cli tool to create what is technical a cluster using docker",
   "version": "0.0.1",
   "author": "acegoal07",
   "bin": {
      "tac": "./bin/run.js"
   },
   "bugs": "https://github.com/acegoal07/tac/issues",
   "dependencies": {
      "@oclif/core": "^4",
      "@oclif/plugin-help": "^6",
      "docker-compose": "^1.4.2",
      "eta": "^4.6.0",
      "ora": "^9.4.1",
      "ssh2": "^1.17.0"
   },
   "devDependencies": {
      "@eslint/compat": "^1",
      "@types/ssh2": "^1.15.5",
      "eslint": "^9",
      "eslint-config-oclif": "^6",
      "eslint-config-prettier": "^10",
      "oclif": "^4",
      "prettier": "^3.9.6",
      "shx": "^0.3.3",
      "ts-node": "^10",
      "typescript": "^5"
   },
   "engines": {
      "node": ">=18.0.0"
   },
   "files": [
      "./bin",
      "./dist",
      "./oclif.manifest.json"
   ],
   "homepage": "https://github.com/acegoal07/tac",
   "keywords": [
      "oclif"
   ],
   "license": "MIT",
   "main": "dist/index.js",
   "oclif": {
      "bin": "tac",
      "dirname": "tac",
      "commands": "./dist/commands",
      "plugins": [
         "@oclif/plugin-help"
      ],
      "topicSeparator": " ",
      "topics": {
         "hello": {
            "description": "Say hello to the world and others"
         }
      }
   },
   "repository": "acegoal07/tac",
   "scripts": {
      "build": "shx rm -rf dist && tsc -b && shx mkdir -p dist/assets && shx cp -r src/assets/setup_scripts dist/assets/ && shx cp -r src/assets/templates dist/assets/ && shx cp -r src/assets/docker dist/assets/",
      "lint": "eslint",
      "format": "npx prettier . --write",
      "postpack": "shx rm -f oclif.manifest.json",
      "posttest": "npm run lint",
      "prepack": "oclif manifest && oclif readme",
      "version": "oclif readme && git add README.md"
   },
   "types": "dist/index.d.ts",
   "prettier": {
      "semi": true,
      "singleQuote": true,
      "trailingComma": "none",
      "printWidth": 100,
      "tabWidth": 3
   }
}
